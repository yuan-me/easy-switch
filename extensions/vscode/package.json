{
  "name": "easy-switch-remote",
  "displayName": "Easy Switch",
  "description": "在 Linux Remote-SSH 中切换 Codex 官方/API 服务商，并保留原聊天。",
  "version": "0.1.3",
  "publisher": "easy-switch",
  "icon": "resources/icon.png",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "~5.8.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easySwitch",
          "title": "Easy Switch",
          "icon": "resources/switch.svg"
        }
      ]
    },
    "views": {
      "easySwitch": [
        {
          "id": "easySwitch.providers",
          "name": "Codex 服务商"
        }
      ]
    },
    "commands": [
      {
        "command": "easySwitch.addProvider",
        "title": "添加服务商",
        "category": "Easy Switch",
        "icon": "$(add)"
      },
      {
        "command": "easySwitch.editProvider",
        "title": "编辑服务商",
        "category": "Easy Switch",
        "icon": "$(edit)"
      },
      {
        "command": "easySwitch.removeProvider",
        "title": "删除服务商",
        "category": "Easy Switch",
        "icon": "$(trash)"
      },
      {
        "command": "easySwitch.switchProvider",
        "title": "切换并重载",
        "category": "Easy Switch",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "easySwitch.refresh",
        "title": "刷新",
        "category": "Easy Switch",
        "icon": "$(refresh)"
      },
      {
        "command": "easySwitch.recover",
        "title": "恢复中断的切换",
        "category": "Easy Switch",
        "icon": "$(history)"
      },
      {
        "command": "easySwitch.reload",
        "title": "重载窗口",
        "category": "Easy Switch"
      },
      {
        "command": "easySwitch.openCodex",
        "title": "打开 Codex",
        "category": "Easy Switch"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "easySwitch.addProvider",
          "when": "view == easySwitch.providers && !easySwitch.busy",
          "group": "navigation@1"
        },
        {
          "command": "easySwitch.refresh",
          "when": "view == easySwitch.providers && !easySwitch.busy",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "easySwitch.switchProvider",
          "when": "view == easySwitch.providers && viewItem =~ /provider/ && !easySwitch.busy",
          "group": "inline@1"
        },
        {
          "command": "easySwitch.editProvider",
          "when": "view == easySwitch.providers && viewItem =~ /provider/ && !easySwitch.busy",
          "group": "inline@2"
        },
        {
          "command": "easySwitch.removeProvider",
          "when": "view == easySwitch.providers && viewItem == api-provider && !easySwitch.busy",
          "group": "management@1"
        }
      ]
    }
  }
}
